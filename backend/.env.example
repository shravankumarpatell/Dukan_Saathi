# Postgres — copy the Session pooler URI from Supabase → Database → Connect.
# Use the service-role / postgres user (bypasses RLS). FastAPI is the only writer.
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase Auth — paste the backend "Copy all" block from the Connect dialog.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Only needed for local `supabase start` (HS256). Hosted projects use JWKS (ES256).
# SUPABASE_JWT_SECRET=

# Gemini — pick ONE:
# A) Google AI Studio key (simplest on an Oracle VM):
# GEMINI_API_KEY=your-ai-studio-key
#
# B) Vertex AI + Application Default Credentials:
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.6-flash
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# CORS
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
