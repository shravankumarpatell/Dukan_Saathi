# Postgres — prefer the Transaction pooler (port 6543). Session mode (5432) caps
# at ~15 clients and will 500 with EMAXCONNSESSION if SQLAlchemy + reload + the
# VM all connect. Use the service-role / postgres user (bypasses RLS).
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase Auth — paste the backend "Copy all" block from the Connect dialog.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Only needed for local `supabase start` (HS256). Hosted projects use JWKS (ES256).
# SUPABASE_JWT_SECRET=

# Gemini — pick ONE:
# A) Google AI Studio key (simplest on an Oracle VM):
# GEMINI_API_KEY=your-ai-studio-key
#
# B) Vertex AI + Application Default Credentials:
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# CORS
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# ── Resilience knobs (defaults are fine; shown for reference) ──
# Auto-reload for local dev. Set APP_ENV=production (or RELOAD=0) on the VM:
# reload spawns a second process that holds its own DB pool.
# RELOAD=1
# APP_ENV=production
# Gemini per-call budget and whole /ai/chat answer budget (seconds).
# GEMINI_TIMEOUT_S=60
# CHAT_TIMEOUT_S=120
# SQLAlchemy pool per process — sized for the transaction pooler (6543).
# On the session pooler (5432, ~15 clients total) use 2 / 1.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=3
# DB_POOL_TIMEOUT_S=10
# DB_CONNECT_TIMEOUT_S=10
